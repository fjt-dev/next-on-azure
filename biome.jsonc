{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/.open-next",
      "!**/.open-next-azure",
      "!**/.azure-app",
      "!**/node_modules",
      "!**/.turbo",
      // Documentation is written by hand; the formatter is for code.
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  // "recommended" must be explicit: `biome migrate` turned the old `recommended: true` into
  // `preset: none`, which switches every rule off without any message.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Strings with ${...} are intended here: code generated for the Function app, and workflow syntax.
      "suspicious": { "noTemplateCurlyInString": "off" }
    }
  },
  "overrides": [
    {
      // OpenNext does not export the revalidate event/result types.
      "includes": ["**/packages/open-next-azure/src/overrides/revalidate.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
