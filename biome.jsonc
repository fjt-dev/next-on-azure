{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/.azure-app",
      "!**/.next-azure",
      "!**/node_modules",
      "!**/.turbo",
      // Documentation is written by hand; the formatter is for code.
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  // "recommended" must be explicit: `biome migrate` turned the old `recommended: true` into
  // `preset: none`, which switches every rule off without any message.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Strings with ${...} are intended here: code generated for the Function app, and workflow syntax.
      "suspicious": { "noTemplateCurlyInString": "off" }
    }
  },
  "overrides": [
    {
      // Required without the node: prefix on purpose: Next.js 16 bundles these files with Turbopack,
      // which cannot load `node:` externals from CommonJS (see azure-storage.cjs).
      "includes": ["**/packages/next-on-azure/src/runtime/*.cjs"],
      "linter": { "rules": { "style": { "useNodejsImportProtocol": "off" } } }
    }
  ]
}
