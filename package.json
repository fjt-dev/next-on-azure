{
  "name": "next-on-azure-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "secret-scan": "node scripts/secret-scan.mjs",
    "license-check": "node scripts/license-check.mjs",
    "e2e:standalone": "node scripts/e2e-standalone.mjs",
    "check-links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^3.0.3",
    "azure-functions-core-tools": "^4.16.0",
    "azurite": "^3.37.0",
    "turbo": "2.11.10"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
